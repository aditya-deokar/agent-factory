# Copy to .env (git-ignored). Agent Factory reads secrets only from the environment;
# agent-factory.yaml stores env var NAMES, never values.

# Domain knowledge graph (code, patterns, decisions, constraints, features, evidence)
NEO4J_URI="bolt://localhost:7687"          # or neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="agentfactory"
NEO4J_DATABASE="neo4j"

# Agent memory workspace (neo4j-agent-memory). Leave MVP_NEO4J_URI empty or equal to
# NEO4J_URI to run both graphs in one instance (same-instance mode).
MVP_NEO4J_URI=""
MVP_NEO4J_USERNAME=""
MVP_NEO4J_PASSWORD=""
MVP_SESSION_ID="your-name"

# LLM + embeddings (OpenAI-compatible; the GraphAcademy proxy works)
OPENAI_API_KEY="..."
OPENAI_BASE_URL="https://graphacademy.neo4j.com/api/llm/v1"
