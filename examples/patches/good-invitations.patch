+++ b/tests/team-invitation.service.test.ts
@@ -0,0 +1,18 @@
+import { describe, it, expect, vi } from "vitest";
+import { TeamInvitationService } from "../src/services/team-invitation.service";
+
+describe("TeamInvitationService", () => {
+  it("invites member by creating token and sending email", async () => {
+    const tokens = { create: vi.fn().mockResolvedValue("tok123"), validate: vi.fn(), consume: vi.fn() };
+    const emails = { send: vi.fn().mockResolvedValue(true) };
+    const teams = { addMember: vi.fn() };
+
+    const service = new TeamInvitationService(tokens as any, emails as any, teams as any);
+    const res = await service.invite("team1", "alice@example.com");
+
+    expect(res).toBe("tok123");
+    expect(tokens.create).toHaveBeenCalledWith("invitation", { teamId: "team1", email: "alice@example.com" });
+    expect(emails.send).toHaveBeenCalled();
+  });
+});
